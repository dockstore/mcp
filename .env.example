# Copy to .env for local development. Every variable is optional; the values
# shown are the defaults.

# stdio (a client launches the server) or http (the server runs as a service).
DOCKSTORE_MCP_TRANSPORT=stdio

# Only used by the http transport.
DOCKSTORE_MCP_HOST=127.0.0.1
DOCKSTORE_MCP_PORT=8000
DOCKSTORE_MCP_PATH=/mcp

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
DOCKSTORE_MCP_LOG_LEVEL=INFO

# Public URL of the Dockstore instance whose APIs this server exposes; links to
# entries point here.
DOCKSTORE_MCP_DOCKSTORE_PUBLIC_URL=https://dockstore.org

# Base URL of the webservice's Dockstore/TRS APIs. Left unset, it is the public URL
# plus /api (or the public URL itself on localhost).
# DOCKSTORE_MCP_DOCKSTORE_API_URL=

# Git tag or ref reported in the User-Agent sent to Dockstore. Normally set at
# build time; left unset, the package version is used.
# DOCKSTORE_MCP_GIT_REF=
